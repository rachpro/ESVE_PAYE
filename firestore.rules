rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == "konerachid12@gmail.com" || 
              request.auth.token.email == "direction@svequipement.com");
    }

    function hasRole(role) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isEditor() {
      return isAdmin() || hasRole('editor');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'editor', 'viewer'];
    }

    // USER RULES
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isSignedIn() && isValidUser(request.resource.data);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // APP DATA RULES
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /payrollSlips/{slipId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /decharges/{dechargeId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
